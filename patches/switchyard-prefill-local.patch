+        first_transform = next(iter(checkpoint["transforms"].values()))
+        self._model_path = str(first_transform["encoder"])
+
+    def metadata(self) -> tuple[str, int]:
+        """Return the encoder and ordered output count consumed by Rust."""
+        return self._model_path, len(self._model_names)
+
+    def forward(self, prompts: list[str], batch_size: int, max_length: int) -> bytes:
+        """Return a row-major F32 probability matrix for ordered prompts."""
+        if not prompts or any(not prompt for prompt in prompts):
+            raise ValueError("prompts must be non-empty")
+        if batch_size <= 0 or max_length <= 0:
+            raise ValueError("batch_size and max_length must be positive")
+
+        rows = []
+        for prompt in prompts:
+            scores = self._scorer.score(prompt)
+            rows.append(scores.confidences)
+        return np.ascontiguousarray(rows, dtype=np.float32).tobytes()
+
+    def unload(self) -> None:
+        self._scorer.unload()
